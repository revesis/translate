# Botguard signing sidecar: a windowless Chromium that mints the
# X-Goog-BatchExecute-Bgr token for translate.google.com's batchexecute RPC.
#
#   podman build --format docker -f Dockerfile.sidecar -t gt-bgr:1.0 .
#   podman run -d --name gt-bgr -p 127.0.0.1:8771:8771 gt-bgr:1.0
#
# Chromium is required: the token has to be produced by Google's own VM inside a
# real browser realm (see README / skill notes). Everything else is plain Python.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_CACHE_HOME=/tmp/.cache

# chromium for the VM, fonts so the canvas/font probes look like a real desktop,
# curl is only for the healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium \
      ca-certificates \
      fonts-liberation \
      fonts-dejavu-core \
      curl \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "websockets>=12,<14"

# Unprivileged user; chromium runs with --no-sandbox, so it does not need any caps.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin sidecar

WORKDIR /app
COPY bgr_sidecar.py /app/bgr_sidecar.py
RUN chown -R 10001:10001 /app

USER 10001

EXPOSE 8771

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8771/health || exit 1

ENTRYPOINT ["python", "/app/bgr_sidecar.py", \
            "--host", "0.0.0.0", \
            "--port", "8771", \
            "--chrome", "/usr/bin/chromium", \
            "--chrome-port", "9501", \
            "--profile-dir", "/tmp/bgr-profile"]
