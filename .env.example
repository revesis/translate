# Copy to .env and edit. Never commit the real file.
#
# Bearer token for the API; leave empty to disable auth (loopback-only setup).
# Generate one with: openssl rand -hex 16
GT_API_KEY=

# Target language when a request omits tl.
GT_DEFAULT_TL=zh-CN

# Upstream proxy, e.g. http://10.0.0.2:7890 -- required if this host cannot
# reach translate.googleapis.com directly (mainland-China networks).
GT_PROXY=

# Override the upstream URL (mirror / gateway). Leave empty for Google.
GT_ENDPOINT=


# Image OCR: chromium used for the botguard token.
# Set to 0 for a text-only deployment (no browser, /translate/image returns no text).
GT_BROWSER=/usr/bin/chromium

# Point at a remote signer instead of running the browser in this container.
# GT_SIGNER_URL=http://signer-host:8771
GT_SIGNER_URL=
